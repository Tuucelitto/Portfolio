---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/experience';
import { resolveLang, useTranslations } from '../i18n/utils';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="experience" class="py-12 sm:py-16">
  <SectionHeading label={t('experience.label')} title={t('experience.title')} />
  <ol class="reveal space-y-6 border-l border-line">
    {
      experience.map(({ role, company, period, description }) => (
        <li class="relative pl-6">
          <span
            class="absolute -left-[5px] top-2 size-2.5 rounded-full bg-accent"
            aria-hidden="true"
          />
          <p class="font-mono text-xs text-muted">{period[lang]}</p>
          <h3 class="mt-1 text-xl font-bold tracking-tight">{role[lang]}</h3>
          <p class="mt-0.5 text-muted">{company}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{description[lang]}</p>
        </li>
      ))
    }
  </ol>
</section>
