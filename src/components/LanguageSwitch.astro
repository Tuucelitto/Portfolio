---
import { languages, type Lang } from '../i18n/ui';
import { getLocalizedPath, resolveLang, useTranslations } from '../i18n/utils';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const target = (Object.keys(languages) as Lang[]).find((code) => code !== lang)!;
---

<a
  href={getLocalizedPath(Astro.url.pathname, target)}
  hreflang={target}
  lang={target}
  aria-label={t('a11y.langSwitch')}
  class="rounded-md border border-control px-2.5 py-1.5 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
>
  {t('a11y.langSwitchShort')}
</a>
